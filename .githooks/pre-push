#!/usr/bin/env bash
# Block pushing lines that name a private repo or this machine's profile path (dev backlog #28).
scanner="$HOME/.claude/scripts/check_public_history.py"
if [ -f "$scanner" ]; then
  # test_module_size.py lists this repo's own non-shipped directory names, one of which
  # the scanner misreads as a private repo name.
  C:/Python314/python.exe "$scanner" --pre-push --allow-path "tests/test_module_size.py" || exit 1
else
  echo "pre-push: $scanner not found, public-history check skipped" >&2
fi

set -e
echo "Running ruff check + format --check before push..."
uv run ruff check
uv run ruff format --check
